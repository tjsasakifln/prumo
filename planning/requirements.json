  "sources": [
    {
      "id": "USR-01",
      "type": "owner_instruction",
      "description": "Criar repositório Prumo e issues sequenciais para sistema estrutural com cobertura dos sistemas de referência, NBRs, BIM nativo, MCP e operação intuitiva."
    },
    {
      "id": "USR-02",
      "type": "owner_instruction",
      "description": "Sempre que pertinente incorporar código de repositórios abertos validados para acelerar módulos específicos."
    },
    {
      "id": "USR-03",
      "type": "owner_instruction",
      "description": "Ampliar o Prumo com todas as funcionalidades documentadas do QiBuilder, preservando estruturas, BIM, MCP, confiabilidade e implementação sequencial."
    },
    {
      "id": "USR-04",
      "type": "owner_instruction",
      "description": "Não citar softwares de referência no README; apresentar o Prumo por suas próprias capacidades.",
      "url": "https://github.com/tjsasakifln/prumo/blob/main/README.md"
    },
    {
      "id": "USR-05",
      "type": "owner_instruction",
      "description": "Complementar issues e documentação para que o sistema Prumo seja implementado em Rust.",
      "url": "https://github.com/tjsasakifln/prumo/blob/main/docs/RUST.md"
    }
